%% faber-programmes — experiment runners for the faber research programmes.
%%
%% This project exists so that runners are PERMANENT without being run on every
%% `rebar3 eunit` of the engine. faber-tweann is consumed here as a library, at a
%% PINNED commit. That pin is the provenance: it records which engine produced a
%% result, which no insight before 047 recorded.
%%
%% Bumping the pin is a deliberate act, and `git log rebar.config` is then the
%% history of which engine each experiment ran against.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_unused_function,
    warn_bif_clash,
    warn_unused_record,
    warn_deprecated_function,
    warn_obsolete_guard,
    warn_export_vars,
    warn_exported_vars
]}.

%% The engine, pinned. Bump deliberately, never to `master`: a floating dep makes
%% every archived result unreproducible, which is the failure this repo exists to fix.
{deps, [
    {faber_tweann,
     {git, "https://github.com/rgfaber/faber-tweann.git",
      {ref, "a5e8bcfc5646827e9be49a9629f8a6a9678c814b"}}}
]}.

%% Only `experiments/` compiles. `programmes/` is the ARCHIVE and is deliberately
%% NOT on any source path: an archived runner is a record of what was run against a
%% specific engine pin, not code we promise to keep compiling against a moving engine.
%% To re-run an archived experiment, check out its pinned engine ref and copy the
%% runner back into experiments/.
{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {extra_src_dirs, ["experiments"]}
    ]},
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/logs"}]}}
]}.

{shell, [
    {apps, [faber_programmes]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% Same faber_min ruleset as the engine. Runners are short-lived but they produce
%% every number in the corpus, so they are held to the house style.
{elvis, [
    {rulesets, #{
        faber_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["experiments/**/*.erl"], ruleset => faber_min}
    ]}
]}.
